# Copy to .env for local development. Never commit a real .env.
DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379/0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Random 32+ character bootstrap API key (accepted with all scopes; not stored in the DB)
ADMIN_API_KEY=replace-with-a-long-random-admin-key

SIGNATURE_TOLERANCE_SECONDS=300
MAX_BODY_BYTES=262144
LOG_LEVEL=INFO

# Allow loopback/private delivery targets. Keep false in production.
ALLOW_PRIVATE_DESTINATIONS=true

# Delivery retries
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_TIMEOUT_SECONDS=10

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hookrelay
